# CrowdSec NGINX Module - Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Captcha credentials
# hCaptcha: https://www.hcaptcha.com/
# Turnstile: https://www.cloudflare.com/products/turnstile/
# reCAPTCHA: https://www.google.com/recaptcha/
CAPTCHA_SITE_KEY=your-captcha-site-key
CAPTCHA_SECRET_KEY=your-captcha-secret-key

# JWT signing key for captcha sessions (generate with: openssl rand -hex 32)
CAPTCHA_SIGNING_KEY=your-64-character-hex-signing-key
